{
  "__purpose__": "Reference palette for base16-black-metal-venom. Use these hex values when theming any app.",
  "__source__": "https://github.com/metalelf0/base16-black-metal-scheme",

  "__raw_palette__": {
    "base00": "#000000",
    "base01": "#121212",
    "base02": "#222222",
    "base03": "#333333",
    "base04": "#999999",
    "base05": "#c1c1c1",
    "base06": "#999999",
    "base07": "#c1c1c1",
    "base08": "#5f8787",
    "base09": "#aaaaaa",
    "base0A": "#79241f",
    "base0B": "#f8f7f2",
    "base0C": "#aaaaaa",
    "base0D": "#888888",
    "base0E": "#999999",
    "base0F": "#444444"
  },

  "__role_map__": {
    "base00": "background / black",
    "base01": "panel bg, selection bg, subtle bg",
    "base02": "element bg, borders, progress bar bg",
    "base03": "comments, muted text, line numbers",
    "base04": "dark foreground, metadata",
    "base05": "default foreground / white",
    "base06": "light foreground (same as base04 often)",
    "base07": "bright foreground, block titles",
    "base08": "red: accent, errors, keywords, headings",
    "base09": "orange: constants, numbers (grey in this theme)",
    "base0A": "yellow: classes, warnings, album, like (blood red)",
    "base0B": "green: strings, success, current playing (off-white)",
    "base0C": "cyan: support, escape, status (grey in this theme)",
    "base0D": "blue: functions, links, info (grey in this theme)",
    "base0E": "magenta: keywords, special (grey in this theme)",
    "base0F": "brown: deprecated, punctuation (dark grey)"
  },

  "__usage_notes__": "Copy the hex values from __raw_palette__ and map by role (__role_map__). Example: for a terminal emulator, base00=bg, base05=fg, base08=red, base0B=green, base0A=yellow, base0D=blue, base0E=magenta, base0C=cyan, base08=bright_red, etc.",

  "__example_spotify_player__": {
    "background": "#000000",
    "foreground": "#c1c1c1",
    "black": "#000000",
    "red": "#5f8787",
    "green": "#f8f7f2",
    "yellow": "#79241f",
    "blue": "#888888",
    "magenta": "#999999",
    "cyan": "#aaaaaa",
    "white": "#c1c1c1",
    "bright_black": "#333333",
    "bright_red": "#5f8787",
    "bright_green": "#f8f7f2",
    "bright_yellow": "#79241f",
    "bright_blue": "#888888",
    "bright_magenta": "#999999",
    "bright_cyan": "#aaaaaa",
    "bright_white": "#c1c1c1",
    "block_title": "#f8f7f2",
    "playback_track": "#c1c1c1",
    "playback_artists": "#5f8787",
    "playback_album": "#79241f",
    "playback_metadata": "#333333",
    "playback_progress_bar": "#222222 bg / #f8f7f2 fg",
    "playback_status": "#aaaaaa",
    "current_playing": "#f8f7f2",
    "page_desc": "#888888",
    "playlist_desc": "#333333",
