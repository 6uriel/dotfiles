#!/bin/sh

NOTES_DIR="$HOME/Documents/notes"
mkdir -p "$NOTES_DIR"

TERM_CMD="foot"
EDITOR_CMD="nvim"

choice=$(find "$NOTES_DIR" -type f \( -name '*.md' -o -name '*.typ' \) -printf '%P\n' 2>/dev/null | wmenu "$@" -l 10 -p 'Note' -i -f "PP Right Grotesk Mono 10" -N "#000000" -n "#c1c1c1" -M "#79241f" -m "#000000" -S "#79241f" -s "#000000")

if [ -z "$choice" ]; then
    exit 0
fi

FILE="$NOTES_DIR/$choice"

$TERM_CMD $EDITOR_CMD "$FILE"
