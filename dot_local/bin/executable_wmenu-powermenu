#!/bin/sh

wmenu_prompt() {
    wmenu "$@" -i -f "PP Right Grotesk Mono 10" \
          -N "#000000" -n "#c1c1c1" -M "#79241f" \
          -m "#000000" -S "#79241f" -s "#000000"
}

lock_cmd="waylock -init-color 0x000000 -input-color 0x222222 -fail-color 0x79241f"

logout_cmd="killall dwl"

choice=$(printf "Shutdown\nReboot\nSuspend\nLogout\nLock\nKill\nKillall" | wmenu_prompt "$@" -p 'Power Menu')

case "$choice" in
    Lock) 
        $lock_cmd 
        ;;
    Logout) 
        $logout_cmd 
        ;;
    Suspend) 
        systemctl suspend 
        ;;
    Reboot) 
        reboot 
        ;;
    Shutdown) 
        poweroff 
        ;;
    Kill)
        selected=$(ps -u "$USER" -o pid,comm --sort=comm | tail -n +2 | awk '{$1=$1; print}' | wmenu_prompt "$@" -p 'Kill PID:' -l 15)
        
        if [ -n "$selected" ]; then
            pid=$(echo "$selected" | awk '{print $1}')
            kill "$pid"
        fi
        ;;
    Killall)
        selected=$(ps -u "$USER" -o comm | tail -n +2 | sort -u | wmenu_prompt "$@" -p 'Killall:' -l 15)
        
        if [ -n "$selected" ]; then
            killall "$selected"
        fi
        ;;
esac
